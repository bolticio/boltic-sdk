{
  "name": "@boltic/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for Boltic databases infrastructure",
  "main": "dist/sdk.js",
  "module": "dist/sdk.mjs",
  "types": "dist/types/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1",
    "npm": ">=8.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/sdk.mjs",
      "require": "./dist/sdk.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "boltic",
    "sdk",
    "typescript",
    "api",
    "database",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bolticio/boltic-sdk.git"
  },
  "scripts": {
    "build": "vite build && node scripts/build.js",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:module": "node scripts/test-module-imports.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write src tests examples docs",
    "docs:generate": "typedoc src/index.ts",
    "docs:serve": "npx serve docs/api",
    "publish:branch": "npm run build && npm publish --tag $(git branch --show-current | sed 's/[^a-zA-Z0-9]/-/g')",
    "publish:latest": "npm run build && npm publish",
    "release": "npm publish",
    "prepublishOnly": "npm run lint && npm run type-check && npm test && npm run build && npm run test:module"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "axios": "^1.20.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "semver": "^7.8.5",
    "terser": "^5.0.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "axios": "^1.20.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
